{
    "name": "tagline-sh",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Open-source GitHub-native AI agent that configures and automates the thinking step of the software release process — not just the mechanics",
    "author": "Moeen Mahmud",
    "license": "MIT",
    "packageManager": "pnpm@10.22.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "pnpm -r build",
        "test": "pnpm -r test",
        "typecheck": "pnpm -r typecheck",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "clean": "pnpm -r clean"
    },
    "devDependencies": {
        "@eslint/js": "^9.13.0",
        "@types/node": "^24.0.0",
        "eslint": "^9.13.0",
        "prettier": "^3.3.3",
        "tsup": "^8.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.11.0",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^2.1.4"
    }
