# GitHub App credentials — from the App settings page
APP_ID=
WEBHOOK_SECRET=

# Private key — pick ONE approach, leave the other commented out.
#
# Recommended: point Probot at a PEM file.
#   Save the downloaded .pem next to this .env file, then:
PRIVATE_KEY_PATH=./private-key.pem
#
# Alternative: inline the PEM with literal \n between lines, in quotes.
# Generate with:
#   awk 'NF {sub(/\r/, ""); printf "%s\\n", $0;}' ./private-key.pem
# PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
#
# IMPORTANT: do NOT leave `PRIVATE_KEY=` set to an empty string — Probot will
# try to validate it as PEM and fail before falling back to PRIVATE_KEY_PATH.

# Required for /release-report AI reasoning. Any OpenAI-compatible provider.
# Leave AI_API_KEY blank to use the deterministic fallback.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini

# Bot server
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Local dev — point Probot at a smee.io channel that forwards webhooks
# to http://localhost:3000/api/github/webhooks
WEBHOOK_PROXY_URL=
